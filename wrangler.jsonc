{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finiteplay",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "finiteplay.org",
      "custom_domain": true
    }
  ]
}
